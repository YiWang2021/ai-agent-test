# 默认不启用真实大模型，项目仍可完整演示 RAG、Tool、安全与评测链路。
SPRING_PROFILES_ACTIVE=postgres,redis
SUPPORT_API_KEY=change-me
SUPPORT_ADMIN_API_KEY=
SUPPORT_OTHER_USER_API_KEY=

# 需要调用 DeepSeek 时改为 ai,postgres,redis，并填写密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 完整模式：先运行 scripts/prepare-embedding.ps1，再使用 ai,postgres,redis,semantic。
# API Key 由服务端绑定用户；管理员必须使用独立 SUPPORT_ADMIN_API_KEY。

# 多人容量保护（所有副本共享相同 namespace/global/tenant/user 限额）
SUPPORT_INSTANCE_LIMIT=16
SUPPORT_GLOBAL_LIMIT=32
SUPPORT_TENANT_LIMIT=16
SUPPORT_USER_LIMIT=2
SUPPORT_USER_RPM=120
SUPPORT_CONCURRENCY_NAMESPACE=default
# 正式运行：ai,postgres,redis,semantic,production，使用 >=32 字符随机凭据。
# 详见 docs/CONCURRENCY.md；production 禁止演示密钥、关闭自动种子和在线评测、只校验已有业务表。
